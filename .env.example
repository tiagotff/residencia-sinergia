GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SEGUNDOS=30
DATABASE_URL=postgresql://sinergia:sinergia@localhost:5432/sinergia
POLITICA_EXTRAIR_CID=true
# Alternativa compatível com Guia A1 v0.7: nao_extrair | extrair_restrito (se definido, prevalece sobre POLITICA_EXTRAIR_CID)
POLITICA_CID=
LIMIAR_CONFIANCA_CAMPO=0.8
PRAZO_ENTREGA_FISICA_DIAS_UTEIS=2
ATESTADOS_STORAGE_DIR=.storage/atestados
MAX_ARQUIVO_BYTES=10485760
MAX_PAGINAS_PDF=5
# WHO ICD API externa (fallback em tempo de execução no Agente 1 quando o CID não existe em afastamento.cid)
# Obtenha Client ID e Client Secret gratuitos em: https://icd.who.int/icdapi
WHO_ICD_ENABLED=true
WHO_ICD_BASE_URL=https://id.who.int
WHO_ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=
WHO_ICD_RELEASE_11=2026-01
WHO_ICD_LINEARIZATION=mms
WHO_ICD_RELEASE_10=2019
WHO_ICD_LANGUAGE=pt
WHO_ICD_TIMEOUT_SEGUNDOS=10
# Container Docker local whoicd/icd-api (2026-01_pt) usado pelo script de seed (seed_cid11.py)
WHO_ICD_SEED_URL=http://localhost:8088
JWT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
